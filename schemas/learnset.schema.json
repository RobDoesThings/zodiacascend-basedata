{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac-ascendant.dev/schemas/learnset.schema.json",
  "title": "Learnset",
  "description": "The moves a creature form can know, keyed by the level it learns them. Generated at build time from move scopes, stages and levels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["creature", "levels"],
  "properties": {
    "creature": { "$ref": "common.schema.json#/$defs/id" },
    "levels": {
      "description": "Map of level (as a string) to the move ids learned at that level.",
      "type": "object",
      "propertyNames": { "pattern": "^([1-9]|[1-3][0-9]|40)$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "combos": {
      "description": "Combo moves available when the named Kindred partner is also on the field.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["move", "partner"],
        "properties": {
          "move": { "$ref": "common.schema.json#/$defs/id" },
          "partner": { "$ref": "common.schema.json#/$defs/zodiac_animal" }
        }
      }
    }
  }
}
