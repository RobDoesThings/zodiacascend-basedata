{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac-ascendant.dev/schemas/creature.schema.json",
  "title": "Creature form",
  "description": "A playable creature: one stage of one line in one element form, e.g. ember-nezrath. Generated by scripts/expand-forms.ts from the line data; never hand-authored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "species", "line", "kind", "family", "stage", "stage_name", "element",
    "form_prefix", "native", "size", "min_level", "stats", "card_moves", "evolves_from",
    "evolves_to", "bond_dc", "learnset"
  ],
  "properties": {
    "id": { "description": "{form-prefix}-{species}, e.g. tide-pipwhisk.", "$ref": "common.schema.json#/$defs/id" },
    "name": { "description": "e.g. Tide Pipwhisk.", "type": "string" },
    "species": { "description": "Base stage id from the line, e.g. pipwhisk.", "$ref": "common.schema.json#/$defs/id" },
    "line": { "$ref": "common.schema.json#/$defs/id" },
    "kind": { "type": "string", "enum": ["zodiac", "wanderer"] },
    "animal": { "$ref": "common.schema.json#/$defs/zodiac_animal" },
    "family": { "$ref": "common.schema.json#/$defs/id" },
    "mythic": { "type": "boolean" },
    "stage": { "$ref": "common.schema.json#/$defs/stage" },
    "stage_name": { "type": "string" },
    "epithet": { "type": "string" },
    "element": { "$ref": "common.schema.json#/$defs/element" },
    "form_prefix": { "type": "string" },
    "native": { "description": "True when this form's element is the line's native element (+1 max Qi).", "type": "boolean" },
    "size": { "$ref": "common.schema.json#/$defs/size" },
    "min_level": { "$ref": "common.schema.json#/$defs/level" },
    "role": { "type": "string" },
    "key_stat": { "$ref": "common.schema.json#/$defs/ability" },
    "stats": { "description": "Final stats with the form's stat bump and native Qi bonus applied.", "$ref": "common.schema.json#/$defs/stats" },
    "trait": { "$ref": "common.schema.json#/$defs/trait" },
    "signature": { "$ref": "common.schema.json#/$defs/id" },
    "card_moves": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "evolves_from": {
      "description": "Creature id of the previous stage in the same element, or null.",
      "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }]
    },
    "evolves_to": {
      "description": "Creature id of the next stage in the same element, or null.",
      "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }]
    },
    "evolution": {
      "description": "Requirements to reach this stage (absent for stage 1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "items", "trial"],
      "properties": {
        "level": { "$ref": "common.schema.json#/$defs/level" },
        "items": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
        "trial": { "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] }
      }
    },
    "bond_dc": {
      "description": "Bond Check DC to befriend this beast in the wild; null when it cannot be befriended outside story events.",
      "oneOf": [{ "type": "integer" }, { "type": "null" }]
    },
    "bond_story_only": { "type": "boolean" },
    "learnset": { "description": "URL of this creature's learnset.", "type": "string" }
  }
}
