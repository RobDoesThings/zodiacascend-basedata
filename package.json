{
  "name": "zodiac-ascendant",
  "version": "0.1.0",
  "description": "Open game data API, lore and rulebook for Zodiac Ascendant: Beasts of the Five Elements",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN README.md",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "drafts": "tsx scripts/build-drafts.ts",
    "art": "tsx scripts/build-art.ts",
    "site": "tsx scripts/build-site.ts",
    "build": "npm run drafts && npm run art && npm run site"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "ajv": "8.17.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "yaml": "2.6.0"
  }
}
