{
  "status": "draft",
  "licence": "CC-BY-4.0",
  "check": {
    "roll": "d20 + discipline ability modifier + Rank (if proficient in the discipline) vs recipe DC",
    "rank_source": "The Keeper's Rank, from the same level table as beasts (data/rules.yaml).",
    "time": "Each recipe lists working days. Two Keepers working together halve it (round up).",
    "outcomes": [
      {
        "id": "ruined",
        "when": "Fail by 5 or more",
        "result": "All materials are lost."
      },
      {
        "id": "failed",
        "when": "Fail by 1–4",
        "result": "No progress; half the materials (round down) are lost."
      },
      {
        "id": "standard",
        "when": "Meet the DC",
        "result": "The piece is made."
      },
      {
        "id": "fine",
        "when": "Beat the DC by 5 or more",
        "result": "+2 durability, and pick one: −1 weight class step for Speed purposes, or +1 to the material's special effect."
      },
      {
        "id": "masterwork",
        "when": "Beat the DC by 10 or more, or a natural 20 that also meets the DC",
        "result": "Fine, plus an inscription slot for a talisman charm (see charms)."
      }
    ]
  },
  "element_synergy": {
    "one_generates_the_other": {
      "dc_change": -2,
      "note": "The materials feed each other, e.g. Wood frame with Fire padding."
    },
    "one_controls_the_other": {
      "dc_change": 3,
      "note": "The materials fight, e.g. Metal facing on a Wood frame."
    },
    "same_element": {
      "dc_change": 0
    },
    "untyped": {
      "dc_change": 0
    },
    "rule": "Compare every pair of typed materials in the recipe; apply each change once per distinct pair."
  },
  "tier_dc_floor": {
    "1": 10,
    "2": 13,
    "3": 16,
    "4": 19
  },
